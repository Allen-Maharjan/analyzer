# Copy to .env and set a strong password: cp .env.example .env
POSTGRES_USER=gold
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gold
# Host ports, bound to 127.0.0.1 only
DB_PORT=55432
API_PORT=8010
# Dashboard sign-in. Use a long password; generate the secret with: openssl rand -hex 32
OWNER_PASSWORD=change-me-too
SESSION_SECRET=
# Dashboard address. WEB_BIND=0.0.0.0 makes it reachable from your phone on home Wi-Fi.
WEB_BIND=127.0.0.1
WEB_PORT=3010
# Set to true once the dashboard is served over HTTPS
COOKIE_SECURE=false
# Shared secret between the API and the host AI runner: openssl rand -hex 32
GA_RUNNER_TOKEN=

# Optional: used by the host AI runner for OpenRouter free models.
GA_OPENROUTER_API_KEY=
# Optional: Neon Postgres (direct, non-pooled connection string). When set, the app uses it instead of the local db.
NEON_DATABASE_URL=
